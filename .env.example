# Aster Mint Detector — Environment Variables
# Copy this file to .env for local development.
# On Railway, set these directly in the project's Variables tab — never commit .env.

# --- Telegram ---
# Your bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# The chat_id of your private operator channel (negative number, e.g. -1001234567890)
# This is where surge alert messages will be posted.
TELEGRAM_CHAT_ID=

# Your personal Telegram user ID — authorises /status, /threshold, /watchlist etc.
# Run check_chat_id.py locally to find this value.
OPERATOR_USER_ID=

# --- RPC Providers ---
# Primary WebSocket RPC (Alchemy)
ALCHEMY_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Fallback WebSocket RPC (QuickNode) — leave blank if not using
QUICKNODE_WS_URL=

# --- API Keys ---
# Alchemy API key (same key used in ALCHEMY_WS_URL)
ALCHEMY_NFT_API_KEY=YOUR_ALCHEMY_KEY

# Etherscan API key — https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# --- Surge Detection ---
# Number of mints within 60 seconds to trigger a surge alert (default: 20)
SURGE_THRESHOLD=20
